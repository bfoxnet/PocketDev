<?xml version="1.0" encoding="utf-8"?>
<!--
  Termux (`https://github.com/termux/termux-app` `activity_termux.xml`) Layout:
  - Full-screen `DrawerLayout` (`@+id/terminal_drawer_layout`)
  - Main content (`@+id/terminal_root`):
    1. Interactive Text Selection Action Bar (`@+id/terminal_selection_bar`, shown when selecting text)
    2. Full-screen `ReTerminalView` (`@+id/terminal_view`, `layout_weight="1"`)
    3. Bottom Termux Helper Keyboard Toolbar (`@+id/extra_keys_container`, `75dp` 2-row height) with:
       - Left Quick Navigation Column:
         - Drawer button (`@+id/btn_toolbar_drawer`) to open/close the session drawer
         - Back arrow button (`@+id/btn_toolbar_back`) to return to the main app
       - Page 0 (`@+id/extra_keys_grid_page`): 2-Row Termux `ExtraKeysView`
       - Page 1 (`@+id/extra_keys_text_input_page`): Termux `terminal_toolbar_text_input` EditText
  - Left Navigation Drawer (`@+id/terminal_session_drawer`, `240dp` width, `layout_gravity="start"`):
    - Top bar: Back to Editor button (`@+id/btn_terminal_back`) & Organized Settings gear button (`@+id/btn_drawer_settings`)
    - Middle (`layout_weight="1"`): Scrollable sessions list (`@+id/drawer_sessions_list`) showing `[1] zsh`, `[2] zsh`
    - Bottom bar: `KEYBOARD` (`@+id/toggle_keyboard_button`) and `NEW SESSION` (`@+id/new_session_button`)
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/terminal_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Main Full-Screen Termux Viewport -->
    <LinearLayout
        android:id="@+id/terminal_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical">

        <!-- Interactive Selection Action Bar (Visible during terminal text selection mode) -->
        <LinearLayout
            android:id="@+id/terminal_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1E222A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/terminal_selection_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono"
                android:singleLine="true"
                android:text="Drag handles to select text"
                android:textColor="#E6EDF3"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_terminal_select_all"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Select All"
                android:textColor="#80DEEA"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_terminal_copy_selection"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Copy"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_terminal_cancel_selection"
                style="@style/PocketDev.IconButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Cancel Selection"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:tint="#E6EDF3" />
        </LinearLayout>

        <!-- Full-Screen Terminal Canvas -->
        <com.bfoxnet.pocketdev.ReTerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Termux Bottom Helper Keyboard Toolbar (Drawer + Back Icons + 2-Row Extra Keys + Text Input Page) -->
        <LinearLayout
            android:id="@+id/extra_keys_container"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="#141414"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingVertical="2dp">

            <!-- Dedicated Helper Keyboard Navigation Column: Drawer Icon (Top) & Back Arrow (Bottom) -->
            <LinearLayout
                android:id="@+id/extra_keys_nav_col"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_toolbar_drawer"
                    style="@style/PocketDev.IconButton"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="1.5dp"
                    android:layout_weight="1"
                    android:contentDescription="Open Terminal Drawer"
                    android:padding="6dp"
                    android:src="@drawable/ic_menu"
                    app:tint="#80DEEA" />

                <ImageButton
                    android:id="@+id/btn_toolbar_back"
                    style="@style/PocketDev.IconButton"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="1.5dp"
                    android:layout_weight="1"
                    android:contentDescription="Back to Main App"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Pages Container (ExtraKeys 2-Row Grid + Text Input Bar) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Page 0: Termux 2-Row ExtraKeysView Grid -->
                <LinearLayout
                    android:id="@+id/extra_keys_grid_page"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingEnd="2dp">

                    <LinearLayout
                        android:id="@+id/extra_keys_row1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/extra_keys_row2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Page 1: Termux Toolbar Text Input View (Toggled via long-press) -->
                <LinearLayout
                    android:id="@+id/extra_keys_text_input_page"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/terminal_toolbar_text_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#80DEEA"
                        android:fontFamily="@font/jetbrains_mono"
                        android:hint="Type command or text (tap KEYS for Extra Keys)…"
                        android:imeOptions="actionSend|flagNoExtractUi"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_switch_to_extra_keys"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="KEYS"
                        android:textColor="#80DEEA"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Exact Termux Left Navigation Drawer (`left_drawer`, 240dp width) -->
    <LinearLayout
        android:id="@+id/terminal_session_drawer"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F2141414"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Top Row: Back to Editor + Alpine QEMU Title + Organized Settings Gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_terminal_back"
                style="@style/PocketDev.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Back to Editor"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E0E0E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/drawer_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Ubuntu 24.04 • Zsh + PRoot"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/drawer_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:singleLine="true"
                    android:text="Ubuntu 24.04.5 LTS • Zsh + Plugins"
                    android:textColor="#9E9E9E"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_drawer_settings"
                style="@style/PocketDev.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Open Organized Settings"
                android:padding="7dp"
                android:src="@drawable/ic_settings"
                app:tint="#E0E0E0" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF" />

        <!-- Middle: Termux Numbered Sessions List (`[1] zsh`) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/drawer_sessions_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF" />

        <!-- Bottom Row: Exact Termux `KEYBOARD` and `NEW SESSION` Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_keyboard_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="KEYBOARD"
                android:textColor="#80DEEA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/new_session_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="NEW SESSION"
                android:textColor="#80DEEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
