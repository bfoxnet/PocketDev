<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#141318"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:singleLine="true"
                android:text="Continue Coding"
                android:textColor="#26A69A"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:singleLine="true"
                android:text="Main.kt"
                android:textColor="#E6E1E5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:text="Tap to resume editing"
                android:textColor="#9E9E9E"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetTerminalBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#25242C"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Terminal"
            android:textColor="#E6E1E5"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetResumeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00695C"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Open"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
