{
  "name": "ruby",
  "scopeName": "source.ruby",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.ruby",
          "begin": "^=begin",
          "end": "^=end"
        },
        {
          "name": "comment.line.ruby",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ruby",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ruby",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ruby",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ruby",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.ruby",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.ruby",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ruby",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.ruby",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ruby",
          "match": "\\b(?:if|elsif|else|unless|case|when|while|until|for|in|do|begin|rescue|ensure|retry|return|break|next|redo|yield|end|then)\\b"
        },
        {
          "name": "keyword.other.ruby",
          "match": "\\b(?:def|class|module|alias|and|not|or|defined|super|self|attr_reader|attr_writer|attr_accessor|private|protected|public|require|require_relative|include|extend|prepend|raise|lambda|proc)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.ruby",
          "match": "\\b(?:Array|Hash|String|Symbol|Integer|Float|Numeric|Range|Regexp|Proc|IO|File|Dir|Time|Exception|StandardError|Object|Class|Module)\\b"
        },
        {
          "name": "entity.name.type.ruby",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.ruby",
          "match": "\\b(?:puts|print|p|gets|chomp|map|select|reject|reduce|each|find|open|sleep|rand|format)\\b"
        },
        {
          "name": "entity.name.function.ruby",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ruby",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ruby",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}