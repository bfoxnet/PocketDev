{
  "name": "rust",
  "scopeName": "source.rust",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.rust",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.rust",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rust",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rust",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.rust",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.rust",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.rust",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.rust",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rust",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.rust",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rust",
          "match": "\\b(?:if|else|match|for|while|loop|break|continue|return|await|yield)\\b"
        },
        {
          "name": "keyword.other.rust",
          "match": "\\b(?:as|async|const|crate|dyn|enum|extern|fn|impl|in|let|mod|move|mut|pub|ref|Self|self|static|struct|super|trait|type|unsafe|use|where|macro_rules)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.rust",
          "match": "\\b(?:bool|char|f32|f64|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|str|String|Vec|Option|Result|Box|Rc|Arc|HashMap|HashSet)\\b"
        },
        {
          "name": "entity.name.type.rust",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.rust",
          "match": "\\b(?:Some|None|Ok|Err|println|eprintln|format|vec|panic|assert|assert_eq|todo|unimplemented|dbg)\\b"
        },
        {
          "name": "entity.name.function.rust",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rust",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rust",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}