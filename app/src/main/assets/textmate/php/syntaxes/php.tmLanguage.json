{
  "name": "php",
  "scopeName": "source.php",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.php",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.php",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.php",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.php",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.php",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.php",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.php",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.php",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.php",
          "match": "\\b(?:if|else|elseif|endif|for|foreach|as|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|match|yield)\\b"
        },
        {
          "name": "keyword.other.php",
          "match": "\\b(?:abstract|and|array|callable|class|clone|const|declare|echo|empty|enum|eval|exit|extends|final|fn|function|global|goto|implements|include|include_once|instanceof|insteadof|interface|isset|list|namespace|new|or|print|private|protected|public|readonly|require|require_once|static|trait|unset|use|var|xor)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.php",
          "match": "\\b(?:int|float|bool|string|array|object|callable|iterable|void|mixed|never|null)\\b"
        },
        {
          "name": "entity.name.type.php",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.php",
          "match": "\\b(?:count|strlen|substr|strpos|explode|implode|json_encode|json_decode|array_map|array_filter|array_merge|in_array|is_array|is_null|var_dump|print_r|header|date|time)\\b"
        },
        {
          "name": "entity.name.function.php",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.php",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.php",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}