{
  "name": "dart",
  "scopeName": "source.dart",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.dart",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.dart",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dart",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.dart",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.dart",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.dart",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.dart",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dart",
          "match": "\\b(?:if|else|for|in|while|do|switch|case|default|break|continue|return|try|catch|on|finally|throw|rethrow|await|yield)\\b"
        },
        {
          "name": "keyword.other.dart",
          "match": "\\b(?:abstract|as|assert|async|base|class|const|covariant|deferred|dynamic|enum|export|extends|extension|external|factory|final|get|hide|implements|import|interface|is|late|library|mixin|new|operator|part|required|sealed|set|show|static|sync|typedef|var|when|with)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.dart",
          "match": "\\b(?:void|bool|num|int|double|String|List|Set|Map|Runes|Symbol|Object|Future|Stream|Iterable|Duration|DateTime|Uri|Widget|BuildContext|StatelessWidget|StatefulWidget|State)\\b"
        },
        {
          "name": "entity.name.type.dart",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.dart",
          "match": "\\b(?:print|identical|debugPrint|setState|runApp)\\b"
        },
        {
          "name": "entity.name.function.dart",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.dart",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.dart",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}