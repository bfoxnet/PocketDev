{
  "name": "yaml",
  "scopeName": "source.yaml",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.yaml",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yaml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yaml",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.yaml",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.yaml",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.yaml",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.yaml",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yaml",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.yaml",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yaml",
          "match": "\\b(?:true|false|yes|no|on|off|null)\\b"
        },
        {
          "name": "keyword.other.yaml",
          "match": "\\b(?:version|services|name|steps|jobs|runs-on|uses|with|env|run|image|ports|volumes|environment|networks|depends_on|build|apiVersion|kind|metadata|spec)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.yaml",
          "match": "\\b(?:str|int|float|bool|seq|map|set|timestamp)\\b"
        },
        {
          "name": "entity.name.type.yaml",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.yaml",
          "match": "\\b(?:include|import|anchor|alias)\\b"
        },
        {
          "name": "entity.name.function.yaml",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.yaml",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.yaml",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}