{
  "name": "css",
  "scopeName": "source.css",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.css",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.css",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.css",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.css",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.css",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.css",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.css",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.css",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.css",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.css",
          "match": "\\b(?:@media|@import|@keyframes|@font-face|@supports|@layer|@container|important)\\b"
        },
        {
          "name": "keyword.other.css",
          "match": "\\b(?:display|position|top|right|bottom|left|width|height|margin|padding|border|background|color|font|font-size|font-weight|font-family|line-height|text-align|flex|grid|align-items|justify-content|gap|opacity|transform|transition|animation|z-index|overflow|cursor|box-shadow)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.css",
          "match": "\\b(?:px|em|rem|vh|vw|vmin|vmax|deg|rad|ms|s|fr|ch|ex)\\b"
        },
        {
          "name": "entity.name.type.css",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.css",
          "match": "\\b(?:rgb|rgba|hsl|hsla|var|calc|min|max|clamp|url|linear-gradient|radial-gradient|translate|scale|rotate)\\b"
        },
        {
          "name": "entity.name.function.css",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.css",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.css",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}