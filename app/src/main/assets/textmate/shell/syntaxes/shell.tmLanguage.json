{
  "name": "shell",
  "scopeName": "source.shell",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.shell",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.shell",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.shell",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.shell",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.shell",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.shell",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.shell",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.shell",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.shell",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.shell",
          "match": "\\b(?:if|then|elif|else|fi|case|esac|for|select|while|until|do|done|in|function|time|return|exit|break|continue)\\b"
        },
        {
          "name": "keyword.other.shell",
          "match": "\\b(?:export|local|readonly|declare|typeset|unset|shift|source|alias|unalias|set|shopt|trap|wait|eval|exec)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.shell",
          "match": "\\b(?:PATH|HOME|USER|SHELL|PWD|OLDPWD|IFS|LD_LIBRARY_PATH|ANDROID_HOME|JAVA_HOME)\\b"
        },
        {
          "name": "entity.name.type.shell",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.shell",
          "match": "\\b(?:echo|printf|read|cd|pwd|ls|cp|mv|rm|mkdir|rmdir|touch|cat|grep|sed|awk|find|xargs|sort|uniq|wc|head|tail|chmod|chown|curl|wget|tar|gzip|unzip|git|docker|apk|apt|pkg|qemu-system-x86_64|qemu-system-aarch64)\\b"
        },
        {
          "name": "entity.name.function.shell",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.shell",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.shell",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}