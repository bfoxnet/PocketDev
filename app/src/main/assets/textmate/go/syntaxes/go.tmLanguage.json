{
  "name": "go",
  "scopeName": "source.go",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.go",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.go",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.go",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.go",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.go",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.go",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.go",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.go",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.go",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.go",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.go",
          "match": "\\b(?:if|else|for|range|switch|case|default|break|continue|return|goto|fallthrough|select|defer|go)\\b"
        },
        {
          "name": "keyword.other.go",
          "match": "\\b(?:package|import|func|var|const|type|struct|interface|map|chan)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.go",
          "match": "\\b(?:bool|byte|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr|any|comparable)\\b"
        },
        {
          "name": "entity.name.type.go",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.go",
          "match": "\\b(?:append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b"
        },
        {
          "name": "entity.name.function.go",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.go",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.go",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}