{
  "name": "scss",
  "scopeName": "source.scss",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.scss",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.scss",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.scss",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.scss",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.scss",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.scss",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.scss",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.scss",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.scss",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.scss",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.scss",
          "match": "\\b(?:@mixin|@include|@function|@return|@if|@else|@for|@each|@while|@extend|@use|@forward|@import|@media|@keyframes)\\b"
        },
        {
          "name": "keyword.other.scss",
          "match": "\\b(?:display|position|top|right|bottom|left|width|height|margin|padding|border|background|color|font|font-size|font-weight|flex|grid|align-items|justify-content|gap|opacity|transform|transition)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.scss",
          "match": "\\b(?:px|em|rem|vh|vw|deg|ms|s|fr)\\b"
        },
        {
          "name": "entity.name.type.scss",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.scss",
          "match": "\\b(?:rgb|rgba|hsl|hsla|var|calc|min|max|clamp|url|darken|lighten|mix|map-get)\\b"
        },
        {
          "name": "entity.name.function.scss",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.scss",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.scss",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}