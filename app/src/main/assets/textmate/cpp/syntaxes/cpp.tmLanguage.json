{
  "name": "cpp",
  "scopeName": "source.cpp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.cpp",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.cpp",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cpp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.cpp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cpp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.cpp",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.cpp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cpp",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.cpp",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cpp",
          "match": "\\b(?:if|else|for|while|do|switch|case|default|break|continue|return|goto|try|catch|throw|co_await|co_return|co_yield)\\b"
        },
        {
          "name": "keyword.other.cpp",
          "match": "\\b(?:alignas|alignof|and|asm|auto|class|concept|const|consteval|constexpr|constinit|const_cast|decltype|delete|dynamic_cast|enum|explicit|export|extern|friend|inline|mutable|namespace|new|noexcept|not|nullptr|operator|or|private|protected|public|register|reinterpret_cast|requires|sizeof|static|static_assert|static_cast|struct|template|thread_local|typedef|typeid|typename|union|using|virtual|volatile|include|define|ifdef|ifndef|endif|pragma)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cpp",
          "match": "\\b(?:void|bool|char|char8_t|char16_t|char32_t|wchar_t|short|int|long|signed|unsigned|float|double|size_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|string|vector|map|set|shared_ptr|unique_ptr)\\b"
        },
        {
          "name": "entity.name.type.cpp",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.cpp",
          "match": "\\b(?:printf|scanf|cout|cin|cerr|endl|std|move|forward|make_shared|make_unique|malloc|free|memcpy|memset)\\b"
        },
        {
          "name": "entity.name.function.cpp",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cpp",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cpp",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}