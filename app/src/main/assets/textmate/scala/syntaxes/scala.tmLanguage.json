{
  "name": "scala",
  "scopeName": "source.scala",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.scala",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.scala",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.scala",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.scala",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.scala",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.scala",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.scala",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.scala",
          "match": "\\b(?:if|then|else|match|case|for|yield|while|do|return|try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.other.scala",
          "match": "\\b(?:abstract|class|def|derives|end|enum|export|extends|extension|final|given|implicit|import|inline|lazy|new|object|opaque|open|override|package|private|protected|sealed|super|this|trait|transparent|type|using|val|var|with)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.scala",
          "match": "\\b(?:Any|AnyRef|AnyVal|Boolean|Byte|Char|Double|Float|Int|Long|Nothing|Null|Short|String|Unit|List|Seq|Vector|Map|Set|Option|Some|None|Either|Future|Try)\\b"
        },
        {
          "name": "entity.name.type.scala",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.scala",
          "match": "\\b(?:println|print|require|assert|locally|identity|implicitly|summon)\\b"
        },
        {
          "name": "entity.name.function.scala",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.scala",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.scala",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}