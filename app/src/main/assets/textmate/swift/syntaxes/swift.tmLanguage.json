{
  "name": "swift",
  "scopeName": "source.swift",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.swift",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.swift",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.swift",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.swift",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.swift",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.swift",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.swift",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.swift",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.swift",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.swift",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.swift",
          "match": "\\b(?:if|else|guard|switch|case|default|for|in|while|repeat|break|continue|fallthrough|return|do|try|catch|throw|throws|rethrows|defer|await|async)\\b"
        },
        {
          "name": "keyword.other.swift",
          "match": "\\b(?:actor|Any|as|associatedtype|borrowing|class|consuming|convenience|deinit|enum|extension|fileprivate|final|func|get|import|indirect|infix|init|inout|internal|is|isolated|lazy|let|macro|mutating|nonisolated|nonmutating|open|operator|optional|override|package|postfix|precedencegroup|prefix|private|protocol|public|required|Self|self|set|some|static|struct|subscript|super|typealias|unowned|var|weak|where|willSet|didSet)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.swift",
          "match": "\\b(?:Int|Int8|Int16|Int32|Int64|UInt|Float|Double|Bool|String|Character|Array|Dictionary|Set|Optional|Result|Void|Never|AnyObject|Error|URL|Data|Date)\\b"
        },
        {
          "name": "entity.name.type.swift",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.swift",
          "match": "\\b(?:print|debugPrint|dump|fatalError|precondition|assert|min|max|abs|zip|stride)\\b"
        },
        {
          "name": "entity.name.function.swift",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.swift",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.swift",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}