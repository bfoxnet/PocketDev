{
  "name": "sql",
  "scopeName": "source.sql",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sql",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.sql",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sql",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.sql",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.sql",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sql",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlLuUiI]?)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.sql",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sql",
          "match": "\\b(?:CASE|WHEN|THEN|ELSE|END|IF|LOOP|WHILE|RETURN|BEGIN|COMMIT|ROLLBACK|case|when|then|else|end)\\b"
        },
        {
          "name": "keyword.other.sql",
          "match": "\\b(?:SELECT|FROM|WHERE|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|ALTER|DROP|TABLE|VIEW|INDEX|DATABASE|SCHEMA|TRIGGER|PROCEDURE|FUNCTION|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|CROSS|ON|AS|DISTINCT|GROUP|BY|HAVING|ORDER|ASC|DESC|LIMIT|OFFSET|UNION|ALL|EXISTS|IN|BETWEEN|LIKE|IS|NOT|AND|OR|PRIMARY|KEY|FOREIGN|REFERENCES|UNIQUE|DEFAULT|CHECK|CONSTRAINT|select|from|where|insert|into|values|update|set|delete|create|alter|drop|table|join|inner|left|right|on|as|group|by|having|order|asc|desc|limit|offset|union|and|or|not|in|is)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.sql",
          "match": "\\b(?:INT|INTEGER|BIGINT|SMALLINT|TINYINT|DECIMAL|NUMERIC|FLOAT|REAL|DOUBLE|VARCHAR|CHAR|TEXT|BLOB|DATE|TIME|DATETIME|TIMESTAMP|BOOLEAN|BOOL|UUID|JSON|JSONB|SERIAL|int|integer|bigint|varchar|text|boolean|timestamp|json)\\b"
        },
        {
          "name": "entity.name.type.sql",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.sql",
          "match": "\\b(?:COUNT|SUM|AVG|MIN|MAX|COALESCE|NULLIF|CAST|CONCAT|SUBSTRING|TRIM|UPPER|LOWER|LENGTH|NOW|DATE_TRUNC|ROW_NUMBER|RANK|DENSE_RANK|count|sum|avg|min|max|coalesce|now)\\b"
        },
        {
          "name": "entity.name.function.sql",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.sql",
          "match": "\\b(?:true|false|null|nil|None|undefined|NaN|Infinity|TRUE|FALSE|NULL|self|this|super|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sql",
          "match": "[+\\-*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}